<div class="tf-top">
    <header class="tf-header">
        <img class="tf-portrait" src="{{actor.img}}" alt="{{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img" data-tooltip="THEFADE.Sheet.editPortrait"{{/if}}>
        <div class="tf-identity">
            {{#if editable}}
            <input class="tf-name" type="text" name="name" value="{{actor.name}}" aria-label="{{localize 'THEFADE.Sheet.name'}}">
            {{else}}
            <h1 class="tf-name">{{actor.name}}</h1>
            {{/if}}
            <div class="tf-kicker">
                <span class="tf-rule" aria-hidden="true"></span>
                <span>{{localize "TYPES.Actor.shop"}}</span>
                <span class="tf-rule" aria-hidden="true"></span>
            </div>
        </div>
        <div class="tf-header-actions">
            {{#if editable}}
            <label class="tf-resource tf-purse">
                <span class="label">{{localize "THEFADE.Shop.treasury"}}</span>
                <span class="value"><input type="number" name="system.currency.serpents" value="{{source.currency.serpents}}" min="0" step="0.01" aria-label="{{localize 'THEFADE.Currency.serpents'}}"><span class="tf-of">sp</span></span>
            </label>
            {{/if}}
            <button type="button" class="tf-button" data-action="sell"><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "THEFADE.Shop.sellToShop"}}</button>
        </div>
    </header>
</div>
