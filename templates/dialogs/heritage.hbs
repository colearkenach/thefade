<div class="thefade tf-dialog">
    <p class="tf-dialog-lead">{{localize "THEFADE.Heritage.lead"}}</p>
    <div class="form-group">
        <label>{{localize "THEFADE.Heritage.mother"}}</label>
        <div class="form-fields">
            <select name="motherType">
                <option value="">{{localize "THEFADE.Heritage.choose"}}</option>
                {{#each types}}<option value="{{code}}" {{#if (eq code @root.motherType)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "THEFADE.Heritage.father"}}</label>
        <div class="form-fields">
            <select name="fatherType">
                <option value="">{{localize "THEFADE.Heritage.choose"}}</option>
                {{#each types}}<option value="{{code}}" {{#if (eq code @root.fatherType)}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label class="checkbox"><input type="checkbox" name="isXenochild" {{#if isXenochild}}checked{{/if}}> {{localize "THEFADE.Heritage.xenochild"}}</label>
        <p class="hint">{{localize "THEFADE.Heritage.xenochildHint"}}</p>
    </div>
    <fieldset data-xenochild-modifiers {{#unless isXenochild}}hidden{{/unless}}>
        <legend>{{localize "THEFADE.Heritage.modifiersLegend"}}</legend>
        {{#each modifiers}}
        <div class="form-group">
            <label class="checkbox"><input type="checkbox" name="{{key}}" {{#if checked}}checked{{/if}}> {{label}} <span class="tf-hint">{{localize "THEFADE.Heritage.rollsBonus" rolls=rolls}}</span></label>
        </div>
        {{/each}}
        <div class="form-group">
            <label>{{localize "THEFADE.Heritage.additionalParents"}}</label>
            <div class="form-fields"><input type="number" name="additionalParents" value="{{additionalParents}}" min="0" step="1"></div>
            <p class="hint">{{localize "THEFADE.Heritage.additionalParentsHint"}}</p>
        </div>
    </fieldset>
    <p class="tf-hint" data-preview></p>
</div>
