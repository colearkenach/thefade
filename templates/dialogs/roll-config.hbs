<div class="thefade tf-dialog">
    <p class="tf-dialog-lead">{{localize "THEFADE.Roll.poolLead" dice=dice}}</p>
    {{#if notes.length}}<ul class="tf-notes">{{#each notes}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    <div class="form-group">
        <label>{{localize "THEFADE.Roll.dt"}}</label>
        <div class="form-fields">
            <input type="number" name="dt" value="{{dt}}" min="1" step="1" autofocus>
            <select name="difficulty" aria-label="{{localize 'THEFADE.Roll.difficulty'}}">
                <option value="">{{localize "THEFADE.Roll.byName"}}</option>
                {{#each difficulties}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}} · {{label}}</option>{{/each}}
            </select>
        </div>
        {{#if allowNoDT}}<label class="checkbox"><input type="checkbox" name="noDT" {{#unless dt}}checked{{/unless}}> {{localize "THEFADE.Roll.noDT"}}</label>{{/if}}
    </div>
    <div class="form-group">
        <label>{{localize "THEFADE.Roll.extraDiceLabel"}}</label>
        <div class="form-fields"><input type="number" name="extraDice" value="0" step="1"></div>
        <p class="hint">{{localize "THEFADE.Roll.extraDiceHint"}}</p>
    </div>
    <div class="form-group">
        <label>{{localize "THEFADE.Roll.mode"}}</label>
        <div class="form-fields"><select name="rollMode">{{#each rollModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    </div>
</div>
