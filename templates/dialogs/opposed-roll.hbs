<div class="thefade tf-dialog">
    <p class="tf-dialog-lead">{{localize "THEFADE.Opposed.lead"}}</p>
    <fieldset>
        <legend>{{actorName}}</legend>
        <div class="form-group">
            <label>{{localize "THEFADE.Opposed.skill"}}</label>
            <div class="form-fields">
                <select name="selfSkill">
                    <option value="">{{localize "THEFADE.Opposed.attributeOnly"}}</option>
                    {{#each selfSkills}}<option value="{{value}}">{{label}}</option>{{/each}}
                </select>
            </div>
        </div>
        <div class="form-group">
            <label>{{localize "THEFADE.Opposed.attribute"}}</label>
            <div class="form-fields">
                <select name="selfAttribute">{{#each attributes}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
            </div>
        </div>
        <div class="form-group">
            <label>{{localize "THEFADE.Roll.extraDiceLabel"}}</label>
            <div class="form-fields"><input type="number" name="selfExtra" value="0" step="1"></div>
        </div>
    </fieldset>
    <fieldset>
        <legend>{{localize "THEFADE.Opposed.opponent"}}</legend>
        <div class="form-group">
            <label>{{localize "THEFADE.Opposed.who"}}</label>
            <div class="form-fields">
                <select name="opponent">{{#each participants}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
            </div>
        </div>
        <div class="form-group">
            <label>{{localize "THEFADE.Opposed.skill"}}</label>
            <div class="form-fields"><select name="opponentSkill"></select></div>
        </div>
        <div class="form-group">
            <label>{{localize "THEFADE.Opposed.attribute"}}</label>
            <div class="form-fields">
                <select name="opponentAttribute">{{#each attributes}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
            </div>
        </div>
        <div class="form-group">
            <label>{{localize "THEFADE.Roll.extraDiceLabel"}}</label>
            <div class="form-fields"><input type="number" name="opponentExtra" value="0" step="1"></div>
        </div>
    </fieldset>
    <div class="form-group">
        <label>{{localize "THEFADE.Roll.mode"}}</label>
        <div class="form-fields"><select name="rollMode">{{#each rollModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    </div>
</div>
