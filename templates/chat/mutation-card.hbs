<div class="thefade chat-card mutation-card">
    <header class="tf-card-header">
        <div class="tf-card-title">
            <h3>{{title}}</h3>
            <span class="tf-card-subtitle">{{actorName}}</span>
        </div>
    </header>
    <div class="tf-result-line">
        <span class="tf-successes"><strong>{{roll}}</strong> {{localize "THEFADE.Mutation.d100"}}</span>
        <span class="tf-vs">{{localize "THEFADE.Mutation.range" range=range}}</span>
    </div>
    <section class="tf-card-section">
        <p><strong>{{name}}</strong></p>
        <p>{{description}}</p>
        <p class="tf-hint">{{added}}</p>
    </section>
</div>
